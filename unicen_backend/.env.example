# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=unicen_db

# Tokens: jwt | paseto
TOKEN_PROVIDER=jwt
JWT_SECRET=super_secret_unicen_key_change_in_prod
JWT_EXPIRES_IN=8h
# Optional: falls back to JWT_SECRET when omitted
# PASETO_SECRET=
